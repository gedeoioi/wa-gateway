{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "composite": true,
    "incremental": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@wa-gateway/config": ["./packages/config/src"],
      "@wa-gateway/config/*": ["./packages/config/src/*"],
      "@wa-gateway/types": ["./packages/types/src"],
      "@wa-gateway/types/*": ["./packages/types/src/*"],
      "@wa-gateway/utils": ["./packages/utils/src"],
      "@wa-gateway/utils/*": ["./packages/utils/src/*"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    ".next"
  ]
}
