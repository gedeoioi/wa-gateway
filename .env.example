# =============================================================================
# WhatsApp Gateway Enterprise - Environment Variables
# =============================================================================

# --- App ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database (MySQL) ---
DATABASE_URL="mysql://root:password@localhost:3306/wa_gateway"

# --- Redis ---
REDIS_URL="redis://localhost:6379"

# --- Authentication ---
# Generate a secure random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-me-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption ---
# 32-character hex string for AES-256 encryption (64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Ports & URLs ---
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
