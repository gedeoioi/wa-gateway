# ===== Server =====
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Public base URL used by Swagger "Try it out"
PUBLIC_BASE_URL=http://localhost:4000

# ===== Security =====
# PENTING: bila NODE_ENV=production, backend akan MENOLAK START apabila salah
# satu secret di bawah masih placeholder/missing, atau FRONTEND_URL berisi
# localhost. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=7d
# 32-byte hex key used to encrypt API keys at rest (AES-256-GCM)
API_KEY_ENCRYPTION_SECRET=change-me-too-32-bytes-hex-or-64-chars

# ===== Database (PostgreSQL) =====
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wa_gateway?schema=public

# ===== Redis (broadcast queue). Leave empty to run in "inline" mode =====
# Kosongkan bila Redis tidak tersedia: broadcast tetap jalan di proses API,
# hanya tanpa queue terpisah (tidak ada retry/persistensi job).
REDIS_URL=redis://localhost:6379

# ===== WhatsApp =====
# Directory where Baileys auth state (session creds) is persisted
WA_SESSION_DIR=./.wa-sessions
# Log Baileys internal debug output
WA_DEBUG=false

# ===== Uploads =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=16

# ===== Rate limits (per IP) =====
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ===== Reverse proxy =====
# Jumlah hop proxy di depan app, dipakai untuk `trust proxy`.
#   1 = hanya Nginx
#   2 = Cloudflare -> Nginx  (default, aman untuk setup ini)
# Jangan dinaikkan tanpa alasan: terlalu banyak hop membuat client bisa
# memalsukan IP lewat X-Forwarded-For dan melewati rate limit.
TRUST_PROXY_HOPS=2
