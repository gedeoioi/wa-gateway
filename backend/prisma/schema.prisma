generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("user")
  plan         String   @default("free")
  isActive     Boolean  @default(true)

  monthlyQuota Int @default(1000)
  usedThisMonth Int @default(0)
  quotaResetAt DateTime @default(now())

  // Per-user device allowance. Null means "inherit from the plan"; admins use
  // this to grant a specific member more (or fewer) devices than their plan.
  deviceLimitOverride Int?
  // Free-form note visible to admins (e.g. why a plan was granted).
  adminNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  devices    Device[]
  apiKeys    ApiKey[]
  messages   Message[]
  broadcasts Broadcast[]

  @@index([email])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String    @unique
  // AES-256-GCM encrypted plaintext key (for reveal in dashboard)
  secretEnc  String
  // SHA-256 hash used for O(1) lookup at auth time
  secretHash String    @unique
  scopes     String[]  @default(["send", "read"])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Device {
  id          String    @id @default(cuid())
  userId      String
  name        String
  phoneNumber String?
  status      String    @default("disconnected") // disconnected | connecting | connected | logged_out
  lastError   String?
  sessionId   String    @unique
  isActive    Boolean   @default(true)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   Message[]
  broadcasts Broadcast[]

  @@index([userId])
  @@index([status])
}

model Message {
  id        String @id @default(cuid())
  userId    String
  deviceId  String?
  direction String @default("outbound") // outbound | inbound

  to        String
  body      String  @db.Text
  type      String  @default("text") // text | image | document

  mediaUrl  String?
  mediaMime String?
  mediaName String?

  status     String    @default("queued") // queued | sending | sent | failed
  providerId String?
  error      String?
  source     String    @default("dashboard") // dashboard | api | broadcast

  broadcastId String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  device    Device?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  broadcast Broadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deviceId])
  @@index([deviceId, providerId])
  @@index([status])
}

model Broadcast {
  id         String @id @default(cuid())
  userId     String
  deviceId   String?
  name       String
  template   String @db.Text
  delayMs    Int    @default(4000)
  batchSize  Int    @default(20)
  batchPauseMs Int  @default(60000)

  status   String @default("queued") // queued | running | completed | failed | cancelled
  total    Int    @default(0)
  sent     Int    @default(0)
  failed   Int    @default(0)
  pending  Int    @default(0)

  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  device     Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  recipients BroadcastRecipient[]
  messages   Message[]

  @@index([userId, createdAt])
}

model BroadcastRecipient {
  id          String @id @default(cuid())
  broadcastId String
  phone       String
  name        String?
  body        String @db.Text
  status      String @default("pending") // pending | sent | failed
  error       String?
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId, status])
}
