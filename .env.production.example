# ===========================================================================
# Konfigurasi PRODUKSI untuk docker-compose.prod.yml
#   cp .env.production.example .env.production
# Jangan commit file .env.production berisi secret asli.
# ===========================================================================

# --- Wajib: generate dengan perintah di bawah, jangan pakai contoh ini -----
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-64-karakter-hex-acak
API_KEY_ENCRYPTION_SECRET=ganti-dengan-64-karakter-hex-acak-berbeda

# --- Database --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti-password-database-yang-kuat
POSTGRES_DB=wa_gateway

# --- Domain publik (WAJIB, tanpa localhost) --------------------------------
# Backend tidak akan mau start bila FRONTEND_URL masih berisi localhost.
PUBLIC_FRONTEND_URL=https://app.domain-anda.com
PUBLIC_API_URL=https://api.domain-anda.com

# --- Port yang dipetakan ke host ------------------------------------------
API_PORT=4000
FRONTEND_PORT=3000

# --- Batas operasional ------------------------------------------------------
MAX_UPLOAD_MB=16
RATE_LIMIT_MAX=120
