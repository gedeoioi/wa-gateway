# ===========================================================================
# Konfigurasi PRODUKSI untuk docker-compose.prod.yml
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# JANGAN commit file .env.production berisi secret asli.
# Setelah mengisi file ini, jalankan: ./deploy.sh --check
# ===========================================================================

# --- WAJIB: generate acak, dua nilai HARUS berbeda -------------------------
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-64-karakter-hex-acak
API_KEY_ENCRYPTION_SECRET=ganti-dengan-64-karakter-hex-acak-berbeda

# --- Database --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti-password-database-yang-kuat
POSTGRES_DB=wa_gateway

# --- Domain publik (WAJIB https, TIDAK BOLEH localhost) --------------------
# Backend menolak start bila nilainya masih localhost.
PUBLIC_FRONTEND_URL=https://wa.domain-anda.com
PUBLIC_API_URL=https://api.domain-anda.com

# --- Port host (diakses Nginx) ---------------------------------------------
# Frontend 3100: karena port 3000 sudah dipakai aplikasi lain di VPS ini.
# Nginx harus proxy_pass ke http://127.0.0.1:3100
FRONTEND_PORT=3100

# API 4000. Nginx harus proxy_pass ke http://127.0.0.1:4000
API_PORT=4000

# --- Akun admin (dipakai oleh ./deploy.sh --first-time) --------------------
# Kosongkan bila ingin membuat admin secara manual.
ADMIN_EMAIL=admin@domain-anda.com
ADMIN_PASSWORD=password-admin-yang-kuat

# --- Batas operasional -----------------------------------------------------
MAX_UPLOAD_MB=16
RATE_LIMIT_MAX=120

# --- Reverse proxy ---------------------------------------------------------
# Jumlah hop proxy di depan API, untuk `trust proxy` dan pembacaan IP klien.
#   1 = hanya Nginx
#   2 = Cloudflare -> Nginx  (default)
# Jangan dinaikkan tanpa alasan: terlalu banyak hop membuat klien bisa
# memalsukan IP lewat X-Forwarded-For dan melewati rate limit.
TRUST_PROXY_HOPS=2
